POSTGRES_DB=fishingstory
POSTGRES_USER=fishingstory
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

VALKEY_HOST=localhost
VALKEY_PORT=6379

# Single local instance only; production requires a unique ID per concurrent instance (0..1023).
SNOWFLAKE_WORKER_ID=0
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_ITERATIONS=2
PASSWORD_ARGON2_PARALLELISM=1

# DEV only. TODO: publish reviewed real policies before launch; never use placeholders in production.
DEV_SEED_TERMS=true
# DEV only: an in-memory RSA key is generated if both configured keys are absent.
# Restarting with an ephemeral key invalidates existing access tokens.
JWT_EPHEMERAL_KEY=true
JWT_ISSUER=fishingstory-api
JWT_AUDIENCE=fishingstory-app
# Base64 of complete PKCS#8 PRIVATE KEY PEM / X.509 PUBLIC KEY PEM (RSA >= 2048 bits).
# Required outside DEV/TEST. Never commit actual private key material.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=

# Enable after setting a private R2 bucket and the four values below.
R2_ENABLED=false
# Independent magazine images switch; uses the same private bucket credentials below.
MAGAZINE_R2_ENABLED=false
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Local Compose binds Valkey to loopback without authentication.
# Set VALKEY_PASSWORD only when connecting to an authenticated server.

# DEV: unquoted KEY=value syntax shared by Compose and Spring properties.
# Use a local alphanumeric password to avoid parser-specific escaping.
# DB_URL/DB_USERNAME/DB_PASSWORD are optional DEV overrides.
# Outside DEV, supply all three as runtime environment variables.

# Decoded data.go.kr service keys; never put them in the mobile app.
# KMA: apply for both short-range forecast and forecast-message services.
FISHING_KMA_SERVICE_KEY=
# KHOA high/low tide forecast; production account requires approval.
FISHING_TIDE_SERVICE_KEY=

# Optional dev-only dummy point registry; prod never exposes demo rows.
DEV_SEED_POINTS=false
